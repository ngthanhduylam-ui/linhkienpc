# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Product images
PRODUCT_UPLOAD_ROOT=./uploads/products
PRODUCT_IMAGE_MAX_BYTES=15728640
PRODUCT_IMAGE_MAX_COUNT=5

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=linhkienpc
DB_USER=root
DB_PASSWORD=your_password
DB_CONNECTION_LIMIT=10

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d
AUTH_REFRESH_REUSE_GRACE_MS=5000
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed defaults
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_DISPLAY_NAME=System Admin
